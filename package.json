{
  "name": "tobikomi-sales-map",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "data:dummy": "node scripts/make-dummy-raw.mjs && node scripts/preprocess.mjs --raw data/raw-dummy --pref 06 --dummy",
    "data:build": "node scripts/preprocess.mjs",
    "data:facilities": "node scripts/facilities.mjs",
    "data:inspect": "node scripts/preprocess.mjs --inspect",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.17",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "^4.4.1",
    "mapshaper": "^0.6.102",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0"
  }
}
