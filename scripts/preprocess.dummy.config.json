{
  "$comment": "ダミーデータ(make-dummy-raw.mjs が作るもの)用の設定。実データ用は preprocess.config.json。",
  "dataYear": 2020,
  "source": "ダミーデータ(国勢調査の形式をまねて作った架空の数値です)",
  "minHouseholds": 30,
  "boundary": {
    "file": "boundary-{pref}.geojson",
    "keyField": "KEY_CODE",
    "prefField": "PREF",
    "cityField": "CITY",
    "prefNameField": "PREF_NAME",
    "cityNameField": "CITY_NAME",
    "nameField": "S_NAME",
    "areaField": "AREA",
    "filter": "HCODE == 8101"
  },
  "boundary2015": {
    "file": "boundary2015-{pref}.geojson",
    "keyField": "KEY_CODE",
    "areaField": "AREA",
    "areaTolerance": 0.02
  },
  "tables": {
    "population": {
      "file": "population2020-{pref}.txt",
      "columns": { "total": "^総数(、年齢「不詳」含む)?$" },
      "ageBands": { "template": "^総数{from}~{to}歳$", "last": "^総数85歳以上$" }
    },
    "population2015": {
      "file": "population2015-{pref}.txt",
      "optional": true,
      "columns": { "total": "^(人口)?総数$" }
    },
    "households": {
      "file": "households-{pref}.txt",
      "columns": { "households": "^世帯総数$", "general": "^一般世帯総数$", "coupleChild": "夫婦と子供から成る世帯$" }
    },
    "labor": {
      "file": "labor-{pref}.txt",
      "ageRange": "15+",
      "columns": { "femaleTotal": "^女(総数|15歳以上人口)$", "femaleEmployed": "^女就業者$" }
    },
    "housing": {
      "file": "housing-{pref}.txt",
      "columns": { "main": "^主世帯総数$", "ownedDetached": "^持ち家一戸建$" }
    }
  }
}
